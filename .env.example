# 使用モデル（必須）。相対パスはChatwellのルート基準。
# 例: ../melody1437/gguf/Melody1437-26B-A4B.i1-Q4_K_M.gguf
CHATWELL_MODEL=
CHATWELL_PORT=8080
CHATWELL_CONTEXT_SIZE=16384
CHATWELL_GPU_LAYERS=99
CHATWELL_START_TIMEOUT=180

# 推論の思考処理。reasoning_effort は明示指定せず、基盤の既定動作に任せます。
CHATWELL_ENABLE_THINKING=true
# 思考トークンの予算。-1は無制限、0は即座に思考を終了。
CHATWELL_REASONING_BUDGET=4096
# llama.cpp の思考抽出形式: auto / none / deepseek / deepseek-legacy
CHATWELL_REASONING_FORMAT=auto
CHATWELL_REASONING_IN_CONTENT=false
# 思考トークンも含む1回の生成上限。入力 llm_config.max_tokens があれば優先。
CHATWELL_MAX_TOKENS=6144
# API呼び出し1回あたりの待機秒数
CHATWELL_REQUEST_TIMEOUT=600
