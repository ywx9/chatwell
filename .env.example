# tools/ loads .env by default; python -m chatwell uses --settings .env. No shell expansion.
CHATWELL_ENDPOINT=http://127.0.0.1:8080
# Optional server-side model ID / alias (NOT a model file path).
# CHATWELL_MODEL=gemma
# Prefer an exported CHATWELL_API_KEY for authenticated servers.
CHATWELL_REQUEST_TIMEOUT=3600
CHATWELL_MAX_TOKENS=6144
CHATWELL_ENABLE_THINKING=true
CHATWELL_REASONING_FORMAT=auto
CHATWELL_REASONING_IN_CONTENT=false

# Optional self-managed-llama (binaries in llama/, model can live anywhere).
SELF_MANAGED_LLAMA=false
LOCAL_GGUF_PATH=
LOCAL_LLAMA_CONTEXT=16384
LOCAL_LLAMA_GPU_LAYERS=auto
LOCAL_LLAMA_START_TIMEOUT=3600
